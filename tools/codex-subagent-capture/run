#!/usr/bin/env bash
# Capture which Codex hook events reach a configured command hook when a controller
# spawns workers, with each payload, the hook's CODEX_* environment and its process
# ancestry. Runs under a private CODEX_HOME: the user's hook config and the relay
# registry are never touched. Only auth.json is copied in, and it is removed on exit.
#
# Usage: tools/codex-subagent-capture/run [--relay RELAY_JS] [--case CASE] [OUT_DIR]
#   --relay     install relay's own hooks (relay install, private state and subscribers)
#               and run each inside the logging hook, which copies the registry after it
#   single      one worker runs one tool and finishes its turn (the default)
#   followup    the controller gives the same worker a second turn (followup_task)
#   badmodel    the spawn names a model that does not exist (Codex refuses the spawn)
#   interrupted the controller interrupts a sleeping worker (interrupt_agent)
#   background  the controller ends its turn without waiting for a sleeping worker; runs
#               the interactive TUI in a detached tmux session, since exec ends the
#               session, and with it the worker, at the controller's Stop
#   nested      a worker spawns its own worker (agents.max_depth = 2; Codex defaults to 1)
#   CODEX_BIN (default: codex), CAPTURE_MODEL (default: the user's configured model),
#   CODEX_AUTH (default: ~/.codex/auth.json), CAPTURE_TIMEOUT seconds (default: 600).
# Prints OUT_DIR; raw payloads land in OUT_DIR/log, one <seq>-<event>.json each.
set -euo pipefail
. "$(dirname "$0")/lib.sh"

relay=
if [[ ${1:-} == --relay ]]; then relay=${2:?--relay needs the path to bin/relay.js}; shift 2; fi
case=single
if [[ ${1:-} == --case ]]; then case=${2:?--case needs a name}; shift 2; fi
only='Do not run any tool yourself other than the agent tools named here.'
case $case in
  single) prompt="Spawn exactly one subagent (worker). Instruct the worker to run the shell command \`echo worker-tool-ran\` and reply with its output. Wait for the worker to finish, then reply with the single word done. $only" ;;
  followup) prompt="Spawn exactly one subagent named worker. Instruct it to run the shell command \`echo first-turn\` and reply with its output. Wait for it to finish. Then give the same worker a follow-up task with followup_task: run \`echo second-turn\` and reply with its output. Wait for it to finish again, then reply with the single word done. $only" ;;
  badmodel) prompt="Spawn exactly one subagent with its model set to \`no-such-model-relay-capture\`. Instruct it to run the shell command \`echo failed-turn\` and reply with its output. If spawning fails, do not retry: reply with the error. Otherwise wait for it to finish, then reply with done and any error the worker reported. $only" ;;
  interrupted) prompt="Spawn exactly one subagent. Instruct it to run the shell command \`sleep 60; echo late\` and reply with its output. Call wait_agent with a timeout of 10000 ms; it will time out. Then interrupt the subagent with interrupt_agent. Then reply with the single word done. $only" ;;
  background) prompt="Spawn exactly one subagent. Instruct it to run the shell command \`sleep 15; echo background-ran\` and reply with its output. Do not wait for it: as soon as the spawn returns, reply with the single word done. $only" ;;
  nested) prompt="Spawn exactly one subagent named outer. Instruct outer to spawn exactly one subagent of its own named inner, which runs the shell command \`echo nested-ran\` and replies with its output; outer waits for inner to finish and then replies done. You wait for outer to finish, then reply with the single word done. $only" ;;
  *) echo "unknown case: $case" >&2; exit 2 ;;
esac

codex=${CODEX_BIN:-codex}
out=${1:-$(mktemp -d "${TMPDIR:-/tmp}/codex-subagent-capture.XXXXXX")}
mkdir -p "$out"/{home,work,log}
out=$(cd "$out" && pwd -P)
home=$out/home

model=${CAPTURE_MODEL:-$(sed -n 's/^model = "\(.*\)"$/\1/p' "$HOME/.codex/config.toml" | head -1)}
[[ -n $model ]] || { echo "set CAPTURE_MODEL: no model in ~/.codex/config.toml" >&2; exit 2; }

child= tmux_session=
cleanup() {
  [[ -n $child ]] && kill "$child" 2>/dev/null || true
  [[ -n $tmux_session ]] && tmux kill-session -t "$tmux_session" 2>/dev/null || true
  scrub_auth "$out"
}
trap cleanup EXIT
trap 'exit 130' INT TERM
capture_home "$out"
if [[ -n $relay ]]; then
  install_relay "$out" "$relay"
  wrap_relay "$out"
  export RELAY_STATE_DIR="$out/relay-state"
else
  plain_hooks "$out"
fi

cat >"$home/config.toml" <<TOML
model = "$model"
approval_policy = "never"
sandbox_mode = "read-only"

[features]
hooks = true
multi_agent = true
TOML
[[ $case == nested ]] && printf '\n[agents]\nmax_depth = 2\n' >>"$home/config.toml"

status=0
if [[ $case == background ]]; then
  printf '\n[projects."%s"]\ntrust_level = "trusted"\n' "$out/work" >>"$home/config.toml"
  tmux_session=relay-capture-$$
  tmux new-session -d -s "$tmux_session" -x 200 -y 50 \
    "CODEX_HOME=$(printf %q "$home") ${relay:+RELAY_STATE_DIR=$(printf %q "$RELAY_STATE_DIR") }$(printf %q "$codex") --dangerously-bypass-hook-trust -C $(printf %q "$out/work") $(printf %q "$prompt")"
  # The worker's SubagentStop, or the timeout, ends the run; the TUI stays up until then.
  deadline=$((SECONDS + ${CAPTURE_TIMEOUT:-600}))
  until compgen -G "$out/log/*-SubagentStop.json" >/dev/null || ((SECONDS >= deadline)); do sleep 1; done
  compgen -G "$out/log/*-SubagentStop.json" >/dev/null || status=124
  sleep 3
  tmux capture-pane -p -t "$tmux_session" >"$out/tui.txt" || true
  # Quit through the TUI so Codex fires SessionEnd; kill only if it has not exited. Enter
  # follows a pause: sent in the same burst, the TUI reads it as pasted text, not a submit.
  tmux send-keys -t "$tmux_session" /quit
  sleep 1
  tmux send-keys -t "$tmux_session" Enter
  quit_deadline=$((SECONDS + 20))
  until compgen -G "$out/log/*-SessionEnd.json" >/dev/null || ((SECONDS >= quit_deadline)); do sleep 1; done
  compgen -G "$out/log/*-SessionEnd.json" >/dev/null || echo "no SessionEnd within 20 s of /quit" >>"$out/tui-shutdown"
  tmux kill-session -t "$tmux_session" 2>/dev/null || true
  tmux_session=
else
  CODEX_HOME=$home timeout "${CAPTURE_TIMEOUT:-600}" "$codex" exec --skip-git-repo-check --dangerously-bypass-hook-trust \
    -C "$out/work" "$prompt" >"$out/exec.stdout" 2>"$out/exec.stderr" &
  child=$!
  wait "$child" || status=$?
  child=
fi
if [[ -n $relay ]]; then
  RELAY_STATE_DIR="$out/relay-state" node "$relay" reap --outer-ms 30000 >/dev/null || status=$?
  if [[ -r $out/relay-state/agents.json ]]; then cp "$out/relay-state/agents.json" "$out/final-agents.json"
  else echo null >"$out/final-agents.json"; fi
fi
"$codex" --version >"$out/codex-version"
echo "$case" >"$out/case"
echo "$out"
exit "$status"
