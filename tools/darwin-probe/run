#!/bin/sh
# Entry point on the Mac: ./run [--allow-linux] [--stages D0,D1,...]
set -eu
# shellcheck disable=SC1007 # CDPATH= scopes to this cd only, so `dirname`'s relative output isn't hijacked.
BUNDLE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
command -v node >/dev/null 2>&1 || { echo "node is not installed (brew install node)" >&2; exit 2; }
major=$(node -p 'process.versions.node.split(".")[0]')
[ "$major" -ge 22 ] || { echo "node $major is older than 22 (brew install node)" >&2; exit 2; }
# A short root under /tmp, not $TMPDIR: macOS puts TMPDIR under /var/folders/xx/<30 chars>/T/,
# which would push a constructed parent (<root>/p/codex, a full path in Darwin's comm) past
# the width plain `ps` gives relay.
ROOT=$(mktemp -d /tmp/rdp.XXXXXX)
KEEP=
# shellcheck disable=SC2329 # invoked by the EXIT trap (shellcheck 0.11 misses it before a final `exit`)
cleanup() {
  if [ -f "$ROOT/pids" ]; then while read -r pid; do kill -s KILL -- "$pid" 2>/dev/null || true; done < "$ROOT/pids"; fi
  if [ -n "$KEEP" ]; then
    # A killed guard probe (D7) leaves its 0600 copy of a harness login under the root.
    if find "$ROOT" -type f \( -name auth.json -o -name .credentials.json \) -exec rm -f -- {} +; then
      scrub="credential copies removed"
    else
      scrub="could not remove every credential copy: find $ROOT -name auth.json -o -name .credentials.json"
    fi
    echo "the probe's working directory is kept at $ROOT; it is unredacted ($scrub), so do not send it" >&2 || true
  else rm -rf "$ROOT"; fi
}
trap cleanup EXIT
# The probe itself handles INT, TERM and HUP: it kills its children and packs the results.
# The shell runs these traps only once node has exited, then falls through to the exit-code
# check below; the root is removed on the way out unless node ended abnormally.
trap : INT TERM HUP
echo "Please close OpenCode (if it is running) for the duration of the probe."
echo "If you use Claude Code, have the output of \`claude setup-token\` ready: the probe may ask for it at the start."
# Idle sleep would expire the probe's deadlines and drop the live harness sessions' network.
# caffeinate -w exits with this shell.
if [ "$(uname -s)" = Darwin ]; then caffeinate -i -w $$ & fi
code=0
node "$BUNDLE/probe/probe.mjs" --bundle "$BUNDLE" --root "$ROOT" "$@" || code=$?
# 0: done; 1: results refused or live paths changed; 2: a prerequisite or usage error;
# 129/130/143: interrupted, results packed. Anything else (70, the probe's own crash; a
# SIGKILL) may have left unpacked results in the root, so it is kept for the user.
case $code in
  0|1|2|129|130|143) ;;
  *) KEEP=1; echo "the probe exited with status $code" >&2 || true ;;
esac
exit "$code"
