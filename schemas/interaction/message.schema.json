{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relay:interaction/message/1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "kind",
    "correlationId",
    "from",
    "to",
    "createdAt",
    "context",
    "body"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/uuid"
    },
    "kind": {
      "enum": [
        "question",
        "answer",
        "defer",
        "withdrawal",
        "notice"
      ]
    },
    "correlationId": {
      "$ref": "#/$defs/uuid"
    },
    "from": {
      "$ref": "#/$defs/party"
    },
    "to": {
      "$ref": "#/$defs/party"
    },
    "createdAt": {
      "$ref": "#/$defs/ms"
    },
    "context": {
      "type": "object",
      "required": [
        "project",
        "taskId",
        "cwd"
      ],
      "properties": {
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "taskId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9-]+-[0-9a-f]{6}$"
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "body": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "question"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/question"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "answer"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/answer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "defer"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/defer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "withdrawal"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/withdrawal"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "notice"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/notice"
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "description": "Lowercase UUID text. Uppercase is refused: ids are compared exactly and name entry files, so two spellings of one UUID would collide on a case-insensitive filesystem.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "surface": {
      "enum": [
        "phone",
        "desktop",
        "cli",
        "terminal"
      ]
    },
    "party": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "agentId"
          ],
          "properties": {
            "kind": {
              "const": "agent"
            },
            "agentId": {
              "type": "string",
              "pattern": "^(claude-code|codex|opencode):.+$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "user"
            }
          }
        }
      ]
    },
    "option": {
      "type": "object",
      "required": [
        "id",
        "label",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 400
        }
      }
    },
    "item": {
      "type": "object",
      "required": [
        "id",
        "header",
        "prompt",
        "type",
        "options",
        "recommended",
        "allowOther",
        "maxLength"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "header": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "type": {
          "enum": [
            "boolean",
            "single",
            "multi",
            "text"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          },
          "maxItems": 4
        },
        "recommended": {
          "type": [
            "string",
            "null"
          ]
        },
        "allowOther": {
          "type": "boolean"
        },
        "maxLength": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 2000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "single",
                  "multi"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "minItems": 2
              },
              "maxLength": {
                "const": null
              }
            }
          },
          "else": {
            "properties": {
              "options": {
                "maxItems": 0
              },
              "recommended": {
                "const": null
              },
              "allowOther": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "boolean"
              }
            }
          },
          "then": {
            "properties": {
              "maxLength": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "question": {
      "type": "object",
      "required": [
        "class",
        "expiresAt",
        "native",
        "artifact",
        "supersedes",
        "items"
      ],
      "properties": {
        "class": {
          "enum": [
            "clarification",
            "artifact-review",
            "authorization"
          ]
        },
        "expiresAt": {
          "$ref": "#/$defs/ms"
        },
        "native": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "harness",
                "sessionId",
                "callId"
              ],
              "properties": {
                "harness": {
                  "enum": [
                    "claude-code",
                    "codex",
                    "opencode"
                  ]
                },
                "sessionId": {
                  "type": "string",
                  "minLength": 1
                },
                "callId": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "artifact": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "ref",
                "revision"
              ],
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "supersedes": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/uuid"
            }
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          },
          "minItems": 1,
          "maxItems": 4
        }
      }
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "optionIds"
          ],
          "properties": {
            "type": {
              "const": "choice"
            },
            "optionIds": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "const": "other"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string",
              "maxLength": 2000
            }
          }
        }
      ]
    },
    "answer": {
      "type": "object",
      "required": [
        "answerId",
        "surface",
        "outcome",
        "artifactRevision",
        "values"
      ],
      "properties": {
        "answerId": {
          "$ref": "#/$defs/uuid"
        },
        "surface": {
          "$ref": "#/$defs/surface"
        },
        "outcome": {
          "enum": [
            "answered",
            "declined"
          ]
        },
        "artifactRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        }
      }
    },
    "defer": {
      "type": "object",
      "required": [
        "surface"
      ],
      "properties": {
        "surface": {
          "$ref": "#/$defs/surface"
        }
      }
    },
    "withdrawal": {
      "type": "object",
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "enum": [
            "asker",
            "user",
            "asker-gone",
            "superseded",
            "answered-elsewhere"
          ]
        }
      }
    },
    "notice": {
      "type": "object",
      "required": [
        "expiresAt",
        "title",
        "text",
        "level"
      ],
      "properties": {
        "expiresAt": {
          "$ref": "#/$defs/ms"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "text": {
          "type": "string",
          "maxLength": 2000
        },
        "level": {
          "enum": [
            "info",
            "warn"
          ]
        }
      }
    }
  }
}
