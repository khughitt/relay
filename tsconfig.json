{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": [
      "es2024"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.js",
    "bin/**/*.js",
    "test/types/**/*.js"
  ]
}
